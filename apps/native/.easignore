# Native build folders - EAS will rebuild these
android/
ios/

# Gradle cache and build files
**/.gradle/
**/build/
**/.cxx/
**/local.properties

# Node modules - EAS will install fresh
node_modules/

# Development files
.expo/
.git/
.vscode/
*.log
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/

# Large files
*.apk
*.aab
*.ipa
