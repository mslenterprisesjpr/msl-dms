{
	"expo": {
		"name": "msl",
		"slug": "msl",
		"version": "1.0.2",
		"orientation": "portrait",
		"icon": "./assets/images/msl-logo.png",
		"scheme": "msl",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.anonymous.msl"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/msl-logo.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.anonymous.msl",
			"permissions": [
				"BLUETOOTH",
				"BLUETOOTH_ADMIN",
				"BLUETOOTH_CONNECT",
				"BLUETOOTH_SCAN",
				"ACCESS_FINE_LOCATION"
			]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/msl-logo.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/msl-logo.png",
					"imageWidth": 220,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#090d16"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "9b9c60fa-27fc-437e-abd7-4257a413b805"
			}
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/9b9c60fa-27fc-437e-abd7-4257a413b805"
		}
	}
}
