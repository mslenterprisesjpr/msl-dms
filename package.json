{
	"name": "msl",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native --",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"deploy:setup": "npx --yes vercel link",
		"dev:vercel": "npx --yes vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "npx --yes vercel deploy",
		"deploy:prod": "npx --yes vercel deploy --prod",
		"deploy:check": "npx --yes vercel deploy --dry",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@msl/config": "*",
		"@types/node": "^26.4.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"tsx": "^4.23.13",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"varlock": "1.18.0"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "npm@12.1.0",
	"allowScripts": {
		"esbuild": true,
		"sharp": true
	},
	"varlock": {
		"loadPath": "./apps/server/"
	}
}
